# 智谱 API（必填）
ZHIPU_API_KEY=your_zhipu_api_key_here

# DeepSeek API（可选，未使用时不填）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Agent 参数（可选，有默认值）
# LLM_TEMPERATURE=0.7
# MAX_TOOL_STEPS=10
# CHUNK_SIZE=300
# CHUNK_OVERLAP=50
# EMBEDDING_BATCH_SIZE=20

# 日志配置（可选）
# LOG_LEVEL=INFO
# LOG_FILE=logs/agent.log

# 对话导出目录（可选，默认 exports/）
# 相对路径按项目根解析；也可以填绝对路径。
# EXPORT_DIR=D:\我的笔记\对话记录

# ============================================================
# API 认证（Week9）
# ============================================================

# API Key 认证（为空则不开启）
# 生产环境建议设置一个强密钥，比如：openssl rand -hex 32
API_KEY=

# JWT 认证（JWT_SECRET 为空则不开启）
# 生产环境必须设置强密钥，比如：openssl rand -hex 64
JWT_SECRET=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

# 限流（每分钟每个 IP 最多请求数，0 表示不限制）
# RATE_LIMIT_PER_MINUTE=60
