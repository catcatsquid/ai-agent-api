# 环境配置
.env
venv/
.venv/

# uv 的缓存（只在生成 requirements.lock 时用；安装本身走 pip，不需要它）
.uv-cache/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 日志与临时数据
*.log
*.sqlite
debug.log

# 运行时产物
extracted/
vector_store_test/
vector_store/
chroma_db/

# 原始课程资料（PDF 体积大，且课件/课本/题库/题图有版权，都不入库）
data/*

# 嵌入缓存
embedding_cache/
*.npy
*.pkl

# 调试脚本
debug/

# 本机沙箱的临时目录（跑服务/评测时必须把 TMP/TEMP 指到这里：系统临时目录不可写，
# Chroma 需要；pytest 的 tmp_path 也会落到它下面）
.tmp/
pytest-of-*/
# 沙箱权限诊断报告（diagnose-windows-sandbox-acl 的产物，本机排查用）
.acl-fix/

# TRAE 内部文件
.trae-html-share-packages/

# npm / node 缓存（跑 tests/js 的 Node 断言时产生的，620 个文件不要入库）
.npm-cache/
node_modules/

# 编辑器/重构留下的一次性备份（终版已入库，这些只是草稿）
*.bak
*.bak_*

# 题库预览（生成物；内容随题库变化，不入库。当前那份已随两份卷子的删除一起删掉）
docs/题目库预览.html

# 压测报告（生成物，每次跑 locust 都会重写 —— README 里的命令就输出到这里）
docs/benchmark_report.html

# 对话导出（/chat/export 落地目录，用户自己的对话记录，不入库）
exports/

# 运行时状态（checkpointer 的库文件 runtime/checkpoints_*.sqlite3，见 graph.py）
runtime/

# 测试结果（JSON）
debug/003-exam-qa-results*.json
debug/005-qa-benchmark.json

# IDE
.vscode/
.idea/
.claude/

# 练习脚本（不传 GitHub）
chat.py
chat_v2.py
prompt_lab.py
rag_lab.py
rag_complete.py
embedding_lab.py
deepseek_demo.py
tool_lab.py
react_lab.py
multi_tool_agent.py

# docs/ 里只保留给人看的说明文件（docs/README.md），其余文档**不随仓库分发**
# —— 这是既定的决定（原先那批文档已移到仓库外）。
# 要新增一个允许入库的文档，就在下面显式加一行例外，例如：
#   !docs/架构决策.md
docs/*.md
!docs/README.md
# 设计取舍与踩坑复盘（README 首屏会链过去，必须能入库）
!docs/design-decisions.md

# ============================================================
# 演示数据集（demo/seed/）—— 必须进仓库
# 理由：README 承诺"docker compose -f docker-compose.demo.yml up 就能看到东西"，
#       而上面的 vector_store/ 通配会把 seed 的向量库一并忽略，所以这里显式放回
# ============================================================
!demo/seed/
!demo/seed/vector_store/
!demo/seed/vector_store/**
# Chroma 运行时写出来的 WAL/SHM 是临时文件，不提交
demo/seed/vector_store/*-wal
demo/seed/vector_store/*-shm
demo/seed/vector_store/**/*-wal
demo/seed/vector_store/**/*-shm

# ============================================================
# 本地决策簿 / 永不入库的评测用例（2026-10-18 用户拍板）
# ============================================================
# eval/backlog.md 是"决策树讨论期间"的待办登记簿：里面 A1/A4/A5 等仍标"待实施"，
# 而代码里早做完了 —— 原样提上去只会误导读它的人，所以留在本地。
eval/backlog.md
# 这条用例本身是给「守卫 12·零步兜底」配的，但用户明确要求不入库
# （守卫 12 的代码与单测已经在 tests/test_planner_guards_2026_10_18.py 里）
eval/cases/plan_zero_step_must_retrieve.json
docker-compose.yml
.scratch/
_notes/
demo/demo-full.mov
